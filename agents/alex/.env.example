# ---- Alex identity (Ahmed: "Alex H, Sales, Plen Dev"). If a prospect asks, Alex says honestly he's an AI assistant.
ALEX_NAME="Alex H"
ALEX_TITLE="Sales, Plen Dev"
ALEX_MAIL_FROM="Alex H at Plen Dev <alex@getplendev.com>"   # recommend a separate sending domain, e.g. getplendev.com
ALEX_REPLY_TO=                                           # empty = replies come back to the Alex mailbox
ALEX_BCC=                                                # copy every email to yourself

# ---- Plen Dev details used in emails
PLENDEV_SITE=https://plendev.com
PLENDEV_EMAIL=info@plendev.com
PLENDEV_PHONE=
PLENDEV_ADDRESS=                     # REQUIRED before any real send (CAN-SPAM). A PO box or virtual office works.
PLENDEV_BOOKING_URL=                 # Cal.com / Calendly link; empty = "reply with a day and time"
PLENDEV_PRICE_FROM=$1,499            # quoted when a lead asks about price
PLENDEV_HOME_AREA=Brooklyn

# ---- web service (report + unsubscribe links)
ALEX_PUBLIC_BASE_URL=https://alex.plendev.com
ALEX_ADMIN_TOKEN=change-me-long-random
PORT=8090
ALEX_DATA_DIR=./data

# ---- targeting
ALEX_MAX_SCORE=72                    # pitch sites scoring at or below this...
ALEX_MIN_SERIOUS=5                   # ...or with at least this many critical/high issues (we always pitch a new site)
ALEX_MIN_PITCH_ISSUES=2
ALEX_AUDIT_PAGES=8
ALEX_CRAWL_DELAY=1.5                 # seconds between requests to a prospect's site (robots.txt crawl-delay wins if higher)
PAGESPEED_API_KEY=                   # free Google key; real mobile speed scores make the pitch stronger
GOOGLE_PLACES_API_KEY=               # optional paid source with the best coverage

# ---- sending
ALEX_SEND_ENABLED=false              # stays false until Ahmed says go; dry-run writes emails to data/outbox/_sent
# MAIL_PROVIDER is set in the mailbox section below; use dryrun for tests
ALEX_DAILY_CAP=30                    # max emails per day once warmed up
ALEX_WARMUP_START=                   # YYYY-MM-DD: first cold-email day (about 2-3 weeks after the mailbox is set up).
                                     # Cap ramps 5/day, +2 per sending day, up to ALEX_DAILY_CAP
ALEX_MIN_GAP_SECONDS=90
ALEX_TZ=America/New_York
ALEX_SEND_DAYS=0,1,2,3,4             # Mon-Fri
ALEX_SEND_HOURS=9,17                 # 9 AM to 5 PM Eastern
ALEX_FOLLOWUP_DAYS=3,7               # follow-up 1 after 3 days, follow-up 2 after 7 more

# ---- Alex's mailbox: Microsoft 365 via GoDaddy (alex@getplendev.com). Secrets live only in the host's env.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alex@getplendev.com
SMTP_PASS=                           # secret; only if Microsoft still allows password SMTP AUTH on the tenant
MS_AUTH=oauth                        # oauth (recommended, see audit-agent/ms_oauth.py) | empty for password login
MS_TENANT_ID=
MS_CLIENT_ID=
MS_REFRESH_TOKEN=                    # secret, from `python3 ms_oauth.py login`
ALEX_IMAP_HOST=outlook.office365.com
ALEX_IMAP_USER=alex@getplendev.com
ALEX_IMAP_PASS=                      # secret; ignored when MS_AUTH=oauth

# ---- notifications and the daily WhatsApp report
ALEX_NOTIFY_WEBHOOK_URL=             # optional Slack/Discord ping for new drafts and replies
ALEX_WHATSAPP_FORWARD=true           # every client reply + Alex's draft goes to Ahmed on WhatsApp
ALEX_DEMO_COUNT=3                    # homepage concepts built for interested leads
WHATSAPP_PROVIDER=print              # print | twilio
WHATSAPP_TO=whatsapp:+14076073296
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                # whatsapp:+1... (Twilio sandbox number for testing)
TWILIO_CONTENT_SID=                  # approved "alex_daily_report" template, needed for production
# Point the Twilio WhatsApp sender's incoming-message webhook at {ALEX_PUBLIC_BASE_URL}/wa so Ahmed can reply
# "queue", "show <id>", "approve <id>", "approve all", "reject <id>", "edit <id>: <text>". Only WHATSAPP_TO is obeyed.

# ---- Writer (Claude). Off until Ahmed approves an Anthropic API key. Templates are used when off.
ALEX_LLM=off                         # on = Claude writes each email and reply from the facts Alex gathered
ALEX_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=                   # secret: set in the host's environment, never in code

# ---- More than one mailbox (each warms up on its own schedule). Leave empty to use the single mailbox above.
# Passwords and tokens are named by env var, never written here.
# ALEX_MAILBOXES=[{"from":"Alex H at Plen Dev <alex@getplendev.com>","user":"alex@getplendev.com","refresh_env":"MS_REFRESH_TOKEN_ALEX","warmup_start":"2026-12-08","daily_cap":30},
#                 {"from":"Alex H at Plen Dev <alex@plendevstudio.com>","user":"alex@plendevstudio.com","refresh_env":"MS_REFRESH_TOKEN_ALEX2","warmup_start":"2026-12-15","daily_cap":30}]
ALEX_MAILBOXES=

# ---- Worker
ALEX_INBOX_EVERY_SECONDS=600         # check replies every 10 minutes during the day (every 30 after hours)
ALEX_TICK_SECONDS=60

# ---- Extra inboxes Alex reads but never sends from. Alex only peeks: nothing is marked read or moved.
# Replies to audit emails (sent as audit@plendev.com) land in the info@ mailbox:
# ALEX_READ_INBOXES=[{"user":"info@plendev.com","refresh_env":"AUDIT_MS_REFRESH_TOKEN"}]
# Optional per entry: "imap_host" (default outlook.office365.com), "folder" (default INBOX), "password_env".
# An ALEX_MAILBOXES entry with "send": false is also read-only.
ALEX_READ_INBOXES=
