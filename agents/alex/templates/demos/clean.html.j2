<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }} | concept 1</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--ink:#0f172a;--mute:#64748b;--line:#e2e8f0;--soft:#f1f5f9;--accent:#2563eb;--accent2:#14b8a6}
*{box-sizing:border-box;margin:0}body{font:16px/1.6 Inter,system-ui,sans-serif;color:var(--ink);background:#fff}
a{color:inherit;text-decoration:none}.wrap{max-width:1160px;margin:0 auto;padding:0 24px}
header{position:sticky;top:0;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);z-index:10}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
.logo{font-weight:800;font-size:20px;letter-spacing:-.02em}.logo i{display:inline-block;width:12px;height:12px;border-radius:4px;background:linear-gradient(135deg,var(--accent),var(--accent2));margin-right:8px}
.links{display:flex;gap:28px;color:var(--mute);font-weight:500}.btn{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;padding:12px 20px;border-radius:10px;font-weight:600}
.btn.ghost{background:#fff;color:var(--ink);border:1px solid var(--line)}
.hero{padding:88px 0 72px;display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.eyebrow{display:inline-block;background:var(--soft);color:var(--accent);font-weight:600;font-size:13px;padding:6px 12px;border-radius:999px;margin-bottom:20px}
h1{font-size:56px;line-height:1.05;letter-spacing:-.035em;font-weight:800}.lead{color:var(--mute);font-size:19px;margin:20px 0 32px;max-width:520px}
.ctas{display:flex;gap:12px;flex-wrap:wrap}
.art{aspect-ratio:1/1;border-radius:28px;background:radial-gradient(circle at 30% 30%,#dbeafe,transparent 55%),radial-gradient(circle at 75% 70%,#ccfbf1,transparent 55%),var(--soft);position:relative;overflow:hidden}
.card{position:absolute;background:#fff;border-radius:16px;box-shadow:0 20px 40px rgba(15,23,42,.12);padding:18px 20px}
.card b{display:block;font-size:15px}.card span{color:var(--mute);font-size:13px}
.c1{left:8%;top:12%;width:62%}.c2{right:8%;bottom:14%;width:58%}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;margin-right:6px}
.slots{display:flex;gap:8px;margin-top:12px}.slots em{font-style:normal;font-size:13px;border:1px solid var(--line);border-radius:8px;padding:6px 10px}.slots em.on{background:var(--accent);color:#fff;border-color:var(--accent)}
section{padding:80px 0}h2{font-size:38px;letter-spacing:-.03em;line-height:1.1;margin-bottom:12px}.sub{color:var(--mute);margin-bottom:40px;max-width:560px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.svc{border:1px solid var(--line);border-radius:18px;padding:28px;transition:.2s}.svc:hover{border-color:var(--accent);transform:translateY(-2px)}
.ico{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#dbeafe,#ccfbf1);margin-bottom:18px}.svc h3{font-size:18px;margin-bottom:6px}.svc p{color:var(--mute);font-size:15px}
.band{background:var(--soft)}.why{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}.why h3{font-size:18px;margin:10px 0 6px}.why p{color:var(--mute)}
.ph{border:2px dashed #cbd5e1;border-radius:18px;padding:36px;text-align:center;color:var(--mute)}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:stretch}.box{border:1px solid var(--line);border-radius:18px;padding:32px}
.box p{margin:8px 0;color:var(--mute)}.box b{color:var(--ink)}.map{border-radius:18px;background:repeating-linear-gradient(45deg,#e2e8f0 0 12px,#f1f5f9 12px 24px);display:grid;place-items:center;color:var(--mute);min-height:260px}
.final{background:linear-gradient(135deg,var(--accent),#1d4ed8);color:#fff;border-radius:28px;padding:56px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
.final h2{color:#fff}.final .btn{background:#fff;color:var(--accent)}
footer{padding:40px 0;color:var(--mute);font-size:14px;border-top:1px solid var(--line)}
@media(max-width:860px){.hero,.contact{grid-template-columns:1fr}.grid,.why{grid-template-columns:1fr}h1{font-size:40px}.links{display:none}.hero{padding:48px 0}.final{padding:32px}.nav .btn{padding:10px 14px;font-size:14px;white-space:nowrap}.logo{font-size:17px}}
</style></head><body>
<header><div class="wrap nav"><a class="logo" href="#"><i></i>{{ name }}</a>
<nav class="links"><a href="#services">Services</a><a href="#about">Why us</a><a href="#reviews">Reviews</a><a href="#contact">Contact</a></nav>
<a class="btn" href="#contact">{{ cta }}</a></div></header>
<main class="wrap">
<div class="hero"><div><span class="eyebrow">{{ noun|capitalize }} in {{ area }}</span>
<h1>{{ headline }}</h1><p class="lead">{{ tagline }}</p>
<div class="ctas"><a class="btn" href="#contact">{{ cta }}</a>{% if phone %}<a class="btn ghost" href="tel:{{ phone }}">Call {{ phone }}</a>{% endif %}</div></div>
<div class="art"><div class="card c1"><b>Book online in under a minute</b><span>Pick a time that works for you</span>
<div class="slots"><em>9:00</em><em class="on">10:30</em><em>1:15</em><em>3:45</em></div></div>
<div class="card c2"><b><span class="dot"></span>Find us</b><span>{{ area }}{% if address %} · {{ address }}{% endif %}</span></div></div></div>
</main>
<section id="services"><div class="wrap"><h2>What we do</h2><p class="sub">Everything you need from a {{ noun }} in {{ area }}, explained simply.</p>
<div class="grid">{% for s in services %}<div class="svc"><div class="ico"></div><h3>{{ s }}</h3><p>A short, clear description of {{ s|lower }} goes here, written for your clients.</p></div>{% endfor %}</div></div></section>
<section id="about" class="band"><div class="wrap"><h2>Easy to reach, easy to book</h2><p class="sub">Your new site is built to turn visitors into booked appointments.</p>
<div class="why"><div><div class="ico"></div><h3>Online booking</h3><p>Clients book any time, even after hours.</p></div>
<div><div class="ico"></div><h3>One tap to call</h3><p>Your number is always one tap away on phones.</p></div>
<div><div class="ico"></div><h3>Fast on every phone</h3><p>Built to load quickly, so nobody gives up waiting.</p></div></div></div></section>
<section id="reviews"><div class="wrap"><h2>What clients say</h2><p class="sub">Your real Google reviews appear here automatically.</p><div class="ph">Your Google reviews here</div></div></section>
<section id="contact"><div class="wrap contact"><div class="box"><h2>Visit or get in touch</h2>
{% if address %}<p><b>Address</b><br>{{ address }}</p>{% endif %}{% if phone %}<p><b>Phone</b><br>{{ phone }}</p>{% endif %}{% if email %}<p><b>Email</b><br>{{ email }}</p>{% endif %}
<p><b>Hours</b><br>Your hours here</p><a class="btn" href="#">{{ cta }}</a></div><div class="map">Map of {{ area }}</div></div></section>
<section><div class="wrap"><div class="final"><div><h2>Ready when you are</h2><p>{{ cta }} in under a minute.</p></div><a class="btn" href="#contact">{{ cta }}</a></div></div></section>
<footer><div class="wrap">© {{ name }} · {{ area }}</div></footer>
{% include "_ribbon.html" %}
</body></html>
