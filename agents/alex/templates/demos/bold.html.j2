<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }} | concept 2</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b1020;--panel:#121a33;--ink:#f8fafc;--mute:#94a3b8;--accent:#f97316;--line:rgba(255,255,255,.08)}
*{box-sizing:border-box;margin:0}html,body{overflow-x:hidden}body{font:16px/1.6 Inter,system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:0 auto;padding:0 24px}h1,h2,h3,.logo{font-family:"Space Grotesk",Inter,sans-serif}
.top{background:var(--accent);color:#111;font-weight:600;font-size:14px;text-align:center;padding:8px 16px}
.nav{display:flex;justify-content:space-between;align-items:center;height:80px}.logo{font-size:24px;font-weight:700;letter-spacing:-.02em}
.links{display:flex;gap:32px;color:var(--mute)}.btn{display:inline-block;background:var(--accent);color:#111;font-weight:700;padding:14px 24px;border-radius:6px}
.btn.line{background:transparent;color:var(--ink);border:1px solid rgba(255,255,255,.25)}
.hero{position:relative;padding:96px 24px 120px}.hero:before{content:"";position:absolute;right:-180px;top:-120px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(249,115,22,.35),transparent 65%)}
.hero h1{font-size:76px;line-height:.98;letter-spacing:-.04em;max-width:820px;position:relative}.hero h1 em{font-style:normal;color:var(--accent)}
.hero p{color:var(--mute);font-size:20px;max-width:560px;margin:28px 0 36px;position:relative}.ctas{display:flex;gap:14px;flex-wrap:wrap;position:relative}
.strip{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.strip div{padding:28px 24px;border-right:1px solid var(--line)}.strip div:last-child{border:0}.strip b{display:block;font-family:"Space Grotesk";font-size:22px}.strip span{color:var(--mute);font-size:14px}
section{padding:96px 0}h2{font-size:48px;letter-spacing:-.03em;line-height:1.05;margin-bottom:40px}
.list{border-top:1px solid var(--line)}.row{display:grid;grid-template-columns:80px 1fr auto;align-items:center;gap:24px;padding:26px 0;border-bottom:1px solid var(--line)}
.row .n{color:var(--accent);font-family:"Space Grotesk";font-weight:700}.row h3{font-size:26px;font-weight:500}.row .arr{color:var(--mute)}
.split{display:grid;grid-template-columns:1fr 1fr;gap:24px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:36px}
.panel p{color:var(--mute);margin:8px 0}.field{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:8px;padding:14px;margin:10px 0;color:var(--mute);font-size:14px}
.ph{border:2px dashed rgba(255,255,255,.2);border-radius:14px;padding:40px;text-align:center;color:var(--mute)}
footer{padding:48px 0;color:var(--mute);border-top:1px solid var(--line);font-size:14px}
@media(max-width:860px){.hero h1{font-size:46px}.links{display:none}.strip,.split{grid-template-columns:1fr}.strip div{border-right:0;border-bottom:1px solid var(--line)}h2{font-size:34px}.row{grid-template-columns:48px 1fr}.row .arr{display:none}.row h3{font-size:20px}.hero{padding:56px 24px 72px}.nav .btn{padding:10px 14px;font-size:14px;white-space:nowrap}.logo{font-size:19px}}
</style></head><body>
<div class="top">{{ noun|capitalize }} in {{ area }}{% if phone %} · Call {{ phone }}{% endif %}</div>
<div class="wrap nav"><a class="logo" href="#">{{ name }}</a><nav class="links"><a href="#services">Services</a><a href="#reviews">Reviews</a><a href="#contact">Contact</a></nav><a class="btn" href="#contact">{{ cta }}</a></div>
<div class="wrap hero"><h1>{{ headline.split(' ')[:-2]|join(' ') }} <em>{{ headline.split(' ')[-2:]|join(' ') }}</em></h1>
<p>{{ tagline }}</p><div class="ctas"><a class="btn" href="#contact">{{ cta }}</a>{% if phone %}<a class="btn line" href="tel:{{ phone }}">{{ phone }}</a>{% endif %}</div></div>
<div class="wrap strip"><div><b>Book online</b><span>Any time, from any phone</span></div><div><b>{{ area }}</b><span>{{ address or "Right in your neighborhood" }}</span></div><div><b>Easy to reach</b><span>Call, message or book online</span></div></div>
<section id="services"><div class="wrap"><h2>Services</h2><div class="list">{% for s in services %}<div class="row"><span class="n">0{{ loop.index }}</span><h3>{{ s }}</h3><span class="arr">→</span></div>{% endfor %}</div></div></section>
<section id="reviews"><div class="wrap"><h2>Reviews</h2><div class="ph">Your Google reviews here</div></div></section>
<section id="contact"><div class="wrap split"><div class="panel"><h2 style="font-size:36px;margin-bottom:16px">{{ cta }}</h2><div class="field">Your name</div><div class="field">Phone or email</div><div class="field">How can we help?</div><a class="btn" href="#" style="margin-top:8px">Send</a></div>
<div class="panel"><h3 style="font-size:22px;margin-bottom:12px">{{ name }}</h3>{% if address %}<p>{{ address }}</p>{% endif %}{% if phone %}<p>{{ phone }}</p>{% endif %}{% if email %}<p>{{ email }}</p>{% endif %}<p>Hours: your hours here</p></div></div></section>
<footer><div class="wrap">© {{ name }} · {{ area }}</div></footer>
{% include "_ribbon.html" %}
</body></html>
