<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ name }} | concept 3</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbf7f1;--ink:#2b2622;--mute:#7a6f66;--accent:#2f6f4f;--sun:#f2c66d;--blush:#f3d9cf;--line:#eadfd3}
*{box-sizing:border-box;margin:0}body{font:17px/1.65 Inter,system-ui,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit;text-decoration:none}.wrap{max-width:1120px;margin:0 auto;padding:0 24px}h1,h2,h3,.logo{font-family:Fraunces,Georgia,serif}
.nav{display:flex;justify-content:space-between;align-items:center;height:84px}.logo{font-size:24px;font-weight:700}
.links{display:flex;gap:28px;color:var(--mute)}.btn{display:inline-block;background:var(--accent);color:#fff;padding:14px 26px;border-radius:999px;font-weight:600}
.btn.soft{background:#fff;color:var(--ink);border:1px solid var(--line)}
.hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding:56px 0 88px}
.hero h1{font-size:60px;line-height:1.05;font-weight:700;letter-spacing:-.02em}.hero p{color:var(--mute);font-size:19px;margin:22px 0 32px}
.ctas{display:flex;gap:12px;flex-wrap:wrap}.blob{position:relative;aspect-ratio:1/1}
.blob i{position:absolute;border-radius:48% 52% 45% 55%/55% 45% 55% 45%}.b1{inset:6% 10% 14% 4%;background:var(--blush)}.b2{width:46%;height:46%;right:2%;bottom:4%;background:var(--sun)}.b3{width:30%;height:30%;left:6%;bottom:10%;background:var(--accent);opacity:.85}
.note{position:absolute;left:18%;top:30%;background:#fff;border-radius:20px;padding:22px 24px;box-shadow:0 18px 40px rgba(43,38,34,.12);max-width:62%}
.note b{font-family:Fraunces;font-size:20px;display:block}.note span{color:var(--mute);font-size:14px}
section{padding:88px 0}h2{font-size:42px;line-height:1.1;margin-bottom:14px}.sub{color:var(--mute);max-width:560px;margin-bottom:44px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.cardw{background:#fff;border-radius:24px;padding:30px;border:1px solid var(--line)}
.cardw .pill{display:inline-block;width:40px;height:40px;border-radius:50%;background:var(--blush);margin-bottom:16px}.cardw:nth-child(3n+2) .pill{background:#d8eadf}.cardw:nth-child(3n) .pill{background:#f8e7bd}
.cardw h3{font-size:21px;margin-bottom:6px}.cardw p{color:var(--mute);font-size:15px}
.green{background:var(--accent);color:#fff;border-radius:32px;padding:64px;display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
.green p{opacity:.85}.green .btn{background:#fff;color:var(--accent)}
.ph{border:2px dashed var(--line);border-radius:24px;padding:40px;text-align:center;color:var(--mute);background:#fff}
.visit{display:grid;grid-template-columns:1fr 1fr;gap:28px}.visit .cardw p{margin:6px 0}
footer{padding:44px 0;color:var(--mute);font-size:14px}
@media(max-width:860px){.hero,.green,.visit{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.hero h1{font-size:42px}.links{display:none}.green{padding:36px}h2{font-size:32px}.nav .btn{padding:10px 16px;font-size:14px;white-space:nowrap}.logo{font-size:19px}}
</style></head><body>
<div class="wrap nav"><a class="logo" href="#">{{ name }}</a><nav class="links"><a href="#services">Services</a><a href="#reviews">Kind words</a><a href="#visit">Visit</a></nav><a class="btn" href="#visit">{{ cta }}</a></div>
<div class="wrap hero"><div><h1>{{ headline }}</h1><p>{{ tagline }}</p><div class="ctas"><a class="btn" href="#visit">{{ cta }}</a>{% if phone %}<a class="btn soft" href="tel:{{ phone }}">Call us</a>{% endif %}</div></div>
<div class="blob"><i class="b1"></i><i class="b2"></i><i class="b3"></i><div class="note"><b>Welcome to {{ name }}</b><span>Your neighborhood {{ noun }} in {{ area }}</span></div></div></div>
<section id="services"><div class="wrap"><h2>How we can help</h2><p class="sub">A friendly, plain-English overview of what we offer.</p>
<div class="cards">{% for s in services %}<div class="cardw"><span class="pill"></span><h3>{{ s }}</h3><p>A warm, short description of {{ s|lower }} goes here.</p></div>{% endfor %}</div></div></section>
<section><div class="wrap green"><div><h2>Booking takes a minute</h2><p>Pick a time online, get a reminder by text, and you're all set.</p></div><div><a class="btn" href="#visit">{{ cta }}</a></div></div></section>
<section id="reviews"><div class="wrap"><h2>Kind words</h2><p class="sub">Your real Google reviews will show here.</p><div class="ph">Your Google reviews here</div></div></section>
<section id="visit"><div class="wrap visit"><div class="cardw"><h2>Come say hello</h2>{% if address %}<p>{{ address }}</p>{% endif %}{% if phone %}<p>{{ phone }}</p>{% endif %}{% if email %}<p>{{ email }}</p>{% endif %}<p>Hours: your hours here</p><p style="margin-top:18px"><a class="btn" href="#">{{ cta }}</a></p></div>
<div class="cardw" style="display:grid;place-items:center;min-height:240px;background:repeating-linear-gradient(45deg,#f3ece3 0 12px,#fbf7f1 12px 24px);color:var(--mute)">Map of {{ area }}</div></div></section>
<footer><div class="wrap">© {{ name }} · {{ area }}</div></footer>
{% include "_ribbon.html" %}
</body></html>
