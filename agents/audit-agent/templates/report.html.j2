{%- set sev_color = {'critical':'#d93025','high':'#e8710a','medium':'#c98a00','low':'#5f6368'} -%}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Website audit: {{ r.site_host }}</title>
<style>
:root{--ink:#1f2330;--mute:#6b7280;--line:#e5e7eb;--bg:#fff;--soft:#f7f7fa;--accent:#4f46e5}
*{box-sizing:border-box}body{margin:0;font:15px/1.55 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg)}
.wrap{max-width:900px;margin:0 auto;padding:32px 16px}
header{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid var(--ink);padding-bottom:16px;margin-bottom:28px;gap:16px;flex-wrap:wrap}
h1{margin:0;font-size:26px}h2{font-size:20px;margin:36px 0 12px}.mute{color:var(--mute)}
.score{display:grid;grid-template-columns:180px 1fr;gap:24px;align-items:center}
.big{font-size:72px;font-weight:800;line-height:1}.big small{font-size:24px;color:var(--mute)}
.bar{background:#eef0f3;border-radius:4px;height:10px}.bar>i{display:block;height:10px;border-radius:4px}
.row{display:grid;grid-template-columns:200px 1fr 40px;gap:12px;align-items:center;margin:6px 0}
.f{border:1px solid var(--line);border-left:4px solid;border-radius:6px;padding:12px 16px;margin:10px 0;break-inside:avoid}
.tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px}
.f h3{margin:2px 0 4px;font-size:16px}.f p{margin:2px 0}
details{margin-top:6px;font-size:13px}code{font-size:12px;word-break:break-all}
table{border-collapse:collapse;width:100%;font-size:13px}td,th{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}
.cta{background:var(--soft);border-radius:10px;padding:20px;margin-top:36px}
.shots{display:grid;grid-template-columns:260px 1fr;gap:20px;align-items:start}
.shots figure{margin:0}.shots img,.clips img{width:100%;border:1px solid var(--line);border-radius:10px;display:block}
figcaption{font-size:12px;color:var(--mute);margin-top:6px;text-align:center}
.legend{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:6px}.legend li{display:flex;gap:10px;align-items:baseline;font-size:14px}
.dot{flex:0 0 22px;height:22px;border-radius:50%;color:#fff;font-weight:700;font-size:12px;display:inline-flex;align-items:center;justify-content:center}
.clips{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-top:14px}
.ck{columns:2;column-gap:28px;font-size:14px}.ck div{break-inside:avoid;padding:3px 0}.ck .x{color:#d93025}.ck .v{color:#188038}
.note{background:var(--soft);border-radius:8px;padding:10px 14px;font-size:14px;margin-top:10px}
@media(max-width:600px){.shots{grid-template-columns:1fr}.ck{columns:1}}
@media(max-width:600px){.score{grid-template-columns:1fr}.row{grid-template-columns:1fr 1fr 34px}}
@media print{.wrap{padding:0}}
</style></head><body><div class="wrap">
<header><div><div class="mute">{{ brand.name }} · Website audit</div><h1>{{ r.site_host }}</h1></div>
<div class="mute">{{ r.generated_at[:10] }} · {{ r.pages_crawled }} pages crawled</div></header>

{%- set ov = r.score.overall -%}
<section class="score">
  <div><div class="big" style="color:{{ '#188038' if ov>=80 else ('#c98a00' if ov>=55 else '#d93025') }}">{{ ov }}<small>/100</small></div>
  <div>Grade <b>{{ ov|grade }}</b></div></div>
  <div>{% for cat, val in r.score.categories.items() %}{% set c = '#188038' if val>=80 else ('#c98a00' if val>=55 else '#d93025') %}
    <div class="row"><span>{{ labels[cat] }}</span><div class="bar"><i style="width:{{ val }}%;background:{{ c }}"></i></div><b style="color:{{ c }}">{{ val }}</b></div>{% endfor %}
  </div>
</section>
{% if r.industry and r.industry.key != 'general' %}<p class="mute">Checked as a <b>{{ r.industry.label|lower }}</b> business, so conversion checks look for the next steps your customers expect.</p>{% endif %}
{% if r.score.cap_reason %}<p class="note">{{ r.score.cap_reason }} The average across all areas is {{ r.score.average }}.</p>{% endif %}

{%- set base = (report_url ~ '/') if report_url else '' -%}
{%- set colors = ['#e11d48','#f59e0b','#7c3aed','#0891b2','#16a34a','#db2777','#ea580c','#2563eb'] -%}
{% if r.visual and r.visual.mobile %}
<h2>What your visitors see</h2>
<p class="mute">Your homepage the moment it opens on a phone and on a laptop. Numbered markers point to the problems we found.</p>
<div class="shots">
  <figure><img src="{{ base }}{{ r.visual.mobile }}" alt="Homepage on a phone"><figcaption>On a phone (390px wide)</figcaption></figure>
  <figure><img src="{{ base }}{{ r.visual.desktop }}" alt="Homepage on a laptop"><figcaption>On a laptop (1366px wide)</figcaption></figure>
</div>
{% if r.visual.clips %}<div class="clips">{% for c in r.visual.clips %}<figure style="margin:0"><img src="{{ base }}{{ c.file }}" alt="Close-up further down the page"><figcaption>Further down on a phone</figcaption></figure>{% endfor %}</div>{% endif %}
{% if r.visual.legend %}<ul class="legend">{% for l in r.visual.legend %}<li><span class="dot" style="background:{{ colors[(l.n - 1) % 8] }}">{{ l.n }}</span><span>{{ l.text }} <span class="mute">({{ l.where }})</span></span></li>{% endfor %}</ul>{% endif %}
{% endif %}

{% if r.pagespeed.mobile and r.pagespeed.mobile.scores %}
<h2>Google PageSpeed (mobile / desktop)</h2>
<table><tr><th></th><th>Mobile</th><th>Desktop</th></tr>
{% for k in ['performance','seo','accessibility','best-practices'] %}<tr><td>{{ k|title }}</td><td>{{ r.pagespeed.mobile.scores.get(k,'–') }}</td><td>{{ (r.pagespeed.desktop or {}).get('scores',{}).get(k,'–') }}</td></tr>{% endfor %}
<tr><td>Largest Contentful Paint</td><td>{{ '%.1fs'|format(r.pagespeed.mobile.lcp_ms/1000) if r.pagespeed.mobile.lcp_ms else '–' }}</td><td>{{ '%.1fs'|format(r.pagespeed.desktop.lcp_ms/1000) if r.pagespeed.desktop and r.pagespeed.desktop.lcp_ms else '–' }}</td></tr>
<tr><td>Cumulative Layout Shift</td><td>{{ '%.2f'|format(r.pagespeed.mobile.cls) if r.pagespeed.mobile.cls is not none else '–' }}</td><td>{{ '%.2f'|format(r.pagespeed.desktop.cls) if r.pagespeed.desktop and r.pagespeed.desktop.cls is not none else '–' }}</td></tr>
</table>
{% elif r.visual and r.visual.measured %}{% set vm = r.visual.measured %}
<h2>Speed on a phone</h2>
<table><tr><th>Measured on a mid-range phone with a slow 4G connection</th><th>Your site</th><th>Good</th></tr>
<tr><td>Main content visible (Largest Contentful Paint)</td><td>{{ 'over 45s' if vm.timed_out else ('%.1fs'|format(vm.lcp_s) if vm.lcp_s else '–') }}</td><td>under 2.5s</td></tr>
<tr><td>Layout shift while loading</td><td>{{ vm.cls }}</td><td>under 0.1</td></tr>
<tr><td>Homepage download size</td><td>{{ '%.1f MB'|format(vm.bytes / 1000000) }}</td><td>under 1.5 MB</td></tr>
<tr><td>Files requested</td><td>{{ vm.requests }}</td><td>under 80</td></tr>
</table>
{% else %}
<p><em>Page speed was not measured in this audit, so it is not part of the score.</em></p>
{% endif %}

{% if r.seo and r.seo.searches %}
<h2>What your customers search for</h2>
<p class="mute">Real searches Google suggests for {{ r.seo.service }}{% if r.seo.areas %} in your area{% endif %}, and whether your site has a page built for each. (Google doesn't publish exact monthly volumes here.)</p>
<table><tr><th>Search</th><th>Page on your site</th></tr>
{% for q in r.seo.searches %}<tr><td>{{ q.query }}</td><td>{% if q.page %}<span style="color:#188038">✓</span> <code>{{ q.page }}</code>{% else %}<span style="color:#d93025">✗ none</span>{% endif %}</td></tr>{% endfor %}
</table>
{% endif %}
{% if r.seo and r.seo.area_pages %}
<h2>Areas you mention vs. pages built to rank there</h2>
<table><tr><th>Area</th><th>Page</th></tr>{% for a, pg in r.seo.area_pages.items() %}<tr><td>{{ a|title }}</td><td>{% if pg %}<span style="color:#188038">✓</span> <code>{{ pg[0] }}</code>{% else %}<span style="color:#d93025">✗ none</span>{% endif %}</td></tr>{% endfor %}</table>
{% endif %}

{% if r.checklist %}{% set passed = r.checklist|selectattr('ok')|list|length %}
<h2>Best-practice checklist: {{ passed }} of {{ r.checklist|length }} passed</h2>
<div class="ck">{% for c in r.checklist %}<div class="{{ 'v' if c.ok else 'x' }}">{{ '✓' if c.ok else '✗' }} <span style="color:var(--ink)">{{ c.label }}</span></div>{% endfor %}</div>
{% endif %}

{% if r.rebuild_case %}<h2>Why a new site beats patching this one</h2>
<ul>{% for line in r.rebuild_case %}<li>{{ line }}</li>{% endfor %}</ul>{% endif %}

<h2>All findings ({{ r.findings|length }})</h2>
{% for cat in labels %}{% set items = r.findings|selectattr('category','equalto',cat)|list %}{% if items %}
<h3 class="mute" style="margin-top:24px">{{ labels[cat] }} · {{ r.score.categories[cat] }}/100</h3>
{% for f in items %}<div class="f" style="border-left-color:{{ sev_color[f.severity] }}">
<div class="tag" style="color:{{ sev_color[f.severity] }}">{{ f.severity }}{% if f.evidence %} · <span class="dot" style="background:{{ colors[(f.evidence.marker - 1) % 8] }};width:18px;height:18px;font-size:11px;vertical-align:middle">{{ f.evidence.marker }}</span> see {{ f.evidence.where }} screenshot{% endif %}</div><h3>{{ f.title }}</h3>
<p>{{ f.detail }}</p>{% if f.impact %}<p><b>What it costs you:</b> {{ f.impact }}</p>{% endif %}{% if brand.pitch != "rebuild" %}<p><b>Fix:</b> {{ f.fix }}</p>{% endif %}
{% if f.pages %}<details><summary>Affected pages ({{ f.pages|length }})</summary>{% for p in f.pages %}<div><code>{{ p }}</code></div>{% endfor %}</details>{% endif %}
</div>{% endfor %}{% endif %}{% endfor %}

<h2>Pages checked</h2>
<table><tr><th>URL</th><th>Title</th><th>H1</th><th>Words</th></tr>
{% for p in r.pages %}<tr><td><code>{{ p.url }}</code></td><td>{{ p.title or '—' }}</td><td>{{ p.h1|length }}</td><td>{{ p.word_count }}</td></tr>{% endfor %}
</table>

<div class="cta">{% if brand.pitch == "rebuild" %}<b>Want a new site that fixes all of this?</b> Reply to our email for 2-3 free homepage concepts, or book a 15-minute call at{% else %}<b>Want {{ brand.name }} to fix this?</b> Book a free 20-minute strategy call at{% endif %} <a href="{{ brand.booking_url }}">{{ brand.booking_url }}</a> or email {{ brand.email }}{% if brand.phone %} / call {{ brand.phone }}{% endif %}.</div>
</div></body></html>
