# --- server
PORT=8080
PUBLIC_BASE_URL=https://audit.plendev.com     # where this server is reachable; used for report links
ADMIN_TOKEN=change-me-long-random             # protects /admin/*
AUDIT_WEBHOOK_SECRET=change-me-shared-with-cms
AUTO_SEND=false                               # Ahmed approves every email (decided 2026-11-17)
AUDIT_MAX_PAGES=15
NOTIFY_WEBHOOK_URL=                           # optional Slack/Discord webhook for "audit ready" pings

# --- CMS (Payload) write-back
CMS_BASE_URL=https://plendev.com
CMS_API_TOKEN=

# --- Google PageSpeed Insights (free key, Google Cloud console > APIs > PageSpeed Insights API)
PAGESPEED_API_KEY=

# --- email
MAIL_PROVIDER=dryrun                          # dryrun | resend | postmark | smtp
MAIL_FROM="Plen Dev <AGENT_ADDRESS@plendev.com>"   # Ahmed is creating this address
MAIL_REPLY_TO=info@plendev.com
MAIL_BCC=                                     # copy every sent audit to yourself
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- branding used in the email
PLENDEV_SITE=https://plendev.com
PLENDEV_PHONE=                                # add later; phone lines hide when empty
PLENDEV_EMAIL=info@plendev.com
PLENDEV_BOOKING_URL=https://plendev.com/book
PLENDEV_SENDER_NAME="Alex H"
PLENDEV_SENDER_TITLE="Sales, Plen Dev"
PLENDEV_ADDRESS=                              # needed before going live (CAN-SPAM)
