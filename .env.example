# Database: SQLite locally, Postgres in production (postgres://...)
DATABASE_URL=file:./plen.db
PAYLOAD_SECRET=change-me-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=change-me
PREVIEW_SECRET=change-me
# Bearer token the audit agent uses: Authorization: Bearer <CMS_API_TOKEN>
CMS_API_TOKEN=change-me
# Where new leads are POSTed (can also be set in CMS > Site Settings > Integrations)
AUDIT_WEBHOOK_URL=
# HMAC-SHA256 secret for the X-PlenDev-Signature header
AUDIT_WEBHOOK_SECRET=change-me
# Optional: first admin created by `pnpm seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
